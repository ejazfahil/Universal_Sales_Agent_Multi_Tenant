# Copy to .env and fill in. NEVER commit .env — this repository is public.

APP_ENV=local
LOG_LEVEL=INFO

# Data residency (invariant I5). Non-EU values refuse to boot in staging/production.
DEPLOYMENT_REGION=eu-central-1

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/usa
REDIS_URL=redis://localhost:6379/0

# Not used until M0-7.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
